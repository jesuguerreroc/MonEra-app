rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Un movimiento válido: monto entero positivo, tipo permitido, cuentas coherentes
    function validTx(d) {
      return d.type in ['expense', 'income', 'transfer']
        && d.amount is int && d.amount > 0 && d.amount < 1000000000000
        && d.accountId is string
        && d.date is string && d.date.size() == 10
        && d.description is string && d.description.size() <= 120
        && (d.type != 'transfer' || (d.toAccountId is string && d.toAccountId != d.accountId));
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Movimientos: validados al crear/editar
      match /transactions/{id} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validTx(request.resource.data);
      }

      // Resto de colecciones del usuario
      match /{coll}/{id} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && coll in ['accounts', 'categories', 'debts', 'receivables', 'budgets', 'goals', 'recurring'];
      }
    }

    // Bot de Telegram: la app crea un código de un solo uso (10 min) que el bot canjea.
    // Nadie puede leer códigos; solo el servidor del bot (que no pasa por estas reglas).
    match /telegramCodes/{code} {
      allow create: if request.auth != null
        && code.matches('^[A-Z0-9]{10}$')
        && request.resource.data.keys().hasOnly(['uid', 'expiresAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.expiresAt is int
        && request.resource.data.expiresAt < request.time.toMillis() + 1800000;
    }

    // Chats vinculados: los escribe el bot; desde la app solo puedes ver y desconectar el tuyo
    match /telegramChats/{chatId} {
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Todo lo demás está cerrado
  }
}
